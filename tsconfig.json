{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2021"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "paths": { "framer": ["./preview/framer-shim.tsx"] }
    },
    "include": ["framer", "preview"]
}
